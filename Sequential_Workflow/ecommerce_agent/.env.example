# WhatsApp bot config (is file ko copy kar ke .env banayen)
MODEL=qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434/api/chat

# Jin chats ko reply hoga (comma se alag). "*" = sab chats (test ke baad hi!)
ALLOWED_CHATS=TEST ZohaibSattar Data. AI

# true = reply bheja nahi jayega, sirf console mein dikhega
DRY_RUN=true

# Insaan review wale messages ko chhota jawab (khali = kuch nahi)
HOLD_REPLY=Assalam o Alaikum! Aapka message mil gaya hai. Hamari team jaldi aapko jawab degi.

POLL_SECONDS=3
DEBUG=false
